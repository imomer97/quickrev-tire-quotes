# Copy this file to .env and fill in your real Canada Tire / NetSuite credentials.
# Never commit .env — it is git-ignored.

# OAuth consumer (integration) credentials
CT_CONSUMER_KEY=
CT_CONSUMER_SECRET=

# OAuth token (TBA) credentials
CT_TOKEN_ID=
CT_TOKEN_SECRET=

# Customer credentials sent in the RESTlet body
CT_CUSTOMER_ID=
CT_CUSTOMER_TOKEN=

# Optional overrides (defaults shown)
CT_ENVIRONMENT=production
CT_ACCOUNT_ID=8031691

# Local dev: the API proxy port (production hosts inject PORT instead)
# PROXY_PORT=3001

# Cloud sync across devices (PC + phone share manual tires & price edits).
# Works locally without these (JSON-file fallback); set DATABASE_URL on the
# server so the data survives restarts and redeploys.
# DATABASE_URL=postgres://user:pass@host/db
# APP_SYNC_KEY=quickrev-app
# VITE_SYNC_KEY=quickrev-app   # optional; must match APP_SYNC_KEY when set
